# Copy this file to .env and fill in real values. .env is gitignored.

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=db_pw_here
DB_NAME=schema_name_here

# Port the Node server (API + WebSocket + static frontend) listens on.
PORT=4414

# Use `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"` to generate.
JWT_SECRET=changeme-generate-a-64-byte-random-hex-string

# Integration API (consumed by external apps like the Price Update python app).
# Only this port should be forwarded through the firewall to the public IP.
INTEGRATION_PORT=7717
PRICE_APP_API_KEY=changeme

# MQTT broker — plaintext TCP (intentional, not TLS).
MQTT_BROKER_URL=tcp://broker-host:1883
MQTT_USERNAME=changeme
MQTT_PASSWORD=changeme
MQTT_CLIENT_ID=server_local

# Comma-separated list of allowed CORS origins for the browser frontend.
# Leave empty for same-origin only (when Express serves the static frontend itself).
CORS_ORIGINS=
